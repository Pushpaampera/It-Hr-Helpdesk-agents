# Copy this file to .env at the repo root and fill in your own values.
# Never commit .env. Never put real secrets in any .md file.

# LLM providers
GROQ_API_KEY=
GEMINI_API_KEY=

# Postgres connection string: postgresql://user:pass@host:port/dbname
# This server's Postgres cluster runs on port 5433 (see docs/05_RUNBOOK.md).
DATABASE_URL=postgresql://user:pass@host:port/dbname

# Auth
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# When true, all agents return deterministic canned responses (no API keys needed)
LLM_MOCK_MODE=false

# Optional: Langfuse tracing (off unless both keys are present)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Direct HR contact shown on the private "Talk to HR" page (not secrets; optional)
HR_CONTACT_EMAIL=
HR_CONTACT_PHONE=
HR_CONTACT_HOURS=

# Outgoing email for notifications (leave decisions, approvals, HR case updates).
# Leave SMTP_HOST empty to turn email off (in-app notifications still work).
# SMTP_SECURITY: starttls (port 587), ssl (port 465) or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
# Demo only: send every email to this one address instead of each user's own address.
EMAIL_REDIRECT_ALL_TO=
# Public address of the site, used for links inside emails.
APP_PUBLIC_URL=http://localhost:5173
